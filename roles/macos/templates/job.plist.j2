<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>{{ launchd_prefix }}.{{ item.label }}</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-c</string>
    <string>{{ item.command | e }}</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
{% for h in range(0, 24, 2) %}
    <dict><key>Hour</key><integer>{{ h }}</integer><key>Minute</key><integer>0</integer></dict>
{% endfor %}
  </array>
  <key>StandardOutPath</key>
  <string>{{ ansible_env.HOME }}/Library/Logs/{{ launchd_prefix }}.{{ item.label }}.log</string>
  <key>StandardErrorPath</key>
  <string>{{ ansible_env.HOME }}/Library/Logs/{{ launchd_prefix }}.{{ item.label }}.log</string>
</dict>
</plist>